{
  "name": "fitcheck",
  "version": "1.0.0",
  "description": "Know before you prompt. Token budgets for AI-native developers.",
  "bin": {
    "fitcheck": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "models.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:action": "ncc build src/action.ts -o dist/action",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build && npm run build:action && npm test"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "llm",
    "ai",
    "cli",
    "tokens",
    "token-counter",
    "context-window",
    "tiktoken",
    "claude",
    "gpt",
    "developer-tools",
    "productivity",
    "fitcheck"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ignore": "^5.3.1",
    "js-tiktoken": "^1.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.15.0"
  }
}
